{
  "portraitScale": 2.1,
  "portraitTranslation": [
    0,
    1.1,
    0
  ],
  "profileScale": 0.9,
  "profileTranslation": [
    0,
    -0.5,
    0
  ],
  "properties": {
    "item_right_display_context": "THIRD_PERSON_RIGHT_HAND",
    "item_left_display_context": "THIRD_PERSON_LEFT_HAND"
  },
  "animations": {
    "send_out": "q.bedrock_primary('custom_model_explorer', 'send_out', q.curve('symmetrical'), q.exclude_labels('look'))",
    "recall": "q.bedrock_primary('custom_model_explorer', 'recall', q.curve('symmetrical'), q.exclude_labels('look'))",
    "command": "q.bedrock_primary('custom_model_explorer', 'command', q.curve('symmetrical'), q.exclude_labels('look'))",
    "win": "q.bedrock_primary('custom_model_explorer', 'win', q.curve('symmetrical'), q.exclude_labels('look'))",
    "lose": "q.bedrock_primary('custom_model_explorer', 'lose', q.curve('symmetrical'), q.exclude_labels('look'))",
    "punch_left": "q.primary_animation(q.punch('head', 'body', 'arm_left', 'arm_right', false), q.curve('symmetrical_wide'), q.exclude_labels('look'))",
    "punch_right": "q.primary_animation(q.punch('head', 'body', 'arm_left', 'arm_right', true), q.curve('symmetrical_wide'), q.exclude_labels('look'))"
  },
  "poses": {
    "battle-standing": {
      "condition": "q.in_battle() == true",
      "poseTypes": [
        "STAND",
        "WALK",
        "FLOAT",
        "SWIM"
      ],
      "animations": [
        "q.look('head')",
        "q.bedrock('custom_model_explorer', 'idle_battle')"
      ]
    },
    "standing": {
      "condition": "q.in_battle() == false",
      "poseTypes": [
        "STAND",
        "WALK"
      ],
      "animations": [
        "q.look('head')",
        "q.bedrock('custom_model_explorer', 'idle')"
      ]
    },
    "floating": {
      "condition": "q.in_battle() == false",
      "poseTypes": [
        "FLOAT"
      ],
      "animations": [
        "q.look('head')",
        "q.bedrock('custom_model_explorer', 'float')"
      ]
    },
    "swimming": {
      "condition": "q.in_battle() == false",
      "poseTypes": [
        "SWIM"
      ],
      "animations": [
        "q.look('head')",
        "q.bedrock('custom_model_explorer', 'swim')"
      ]
    },
    "sleeping": {
      "poseTypes": [
        "SLEEP"
      ],
      "animations": [
        "q.bedrock('custom_model_explorer', 'sleep')"
      ]
    },
    "portrait": {
      "poseTypes": [
        "PORTRAIT",
        "PROFILE"
      ],
      "animations": [
        "q.bedrock('custom_model_explorer', 'idle')"
      ]
    }
  }
}
